rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /photoUrls/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid + ".jpg" == userId
        && request.resource.size < 10 * 1024 * 1024 // 10MB cap
        && request.resource.contentType.matches('image/.*');
    }

    match /bannerUrls/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid + ".jpg" == userId
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
